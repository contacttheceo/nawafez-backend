APP_NAME=Nawafez
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.freehostia.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
